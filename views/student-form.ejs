<%- include('partials/header') %><div class="page-heading"><span class="eyebrow">STUDENT INFORMATION</span><h1><%= title %></h1><p class="muted">Fields marked with * are required.</p></div><div class="form-card"><% if (error || formError) { %><div class="alert alert-danger"><%= error || formError %></div><% } %><form method="POST" action="<%= action %>" class="needs-validation" novalidate><div class="row g-3"><div class="col-md-6"><label class="form-label">Full name *</label><input class="form-control" name="name" required minlength="2" maxlength="80" value="<%= student.name || formValues.name || '' %>"></div><div class="col-md-6"><label class="form-label">Email *</label><input class="form-control" type="email" name="email" required value="<%= student.email || formValues.email || '' %>"></div><div class="col-md-6"><label class="form-label">Course *</label><input class="form-control" name="course" required value="<%= student.course || formValues.course || '' %>" placeholder="e.g. B.Tech Computer Science"></div><div class="col-md-6"><label class="form-label">Enrollment number *</label><input class="form-control" name="enrollmentNo" required minlength="3" maxlength="30" value="<%= student.enrollmentNo || formValues.enrollmentNo || '' %>"></div><div class="col-md-6"><label class="form-label">Phone</label><input class="form-control" name="phone" pattern="[0-9+()\-\s]{7,20}" value="<%= student.phone || formValues.phone || '' %>" placeholder="Optional"></div><div class="col-md-6"><label class="form-label">Status</label><select class="form-select" name="status"><option <%= student.status==='Active'?'selected':'' %>>Active</option><option <%= student.status==='Inactive'?'selected':'' %>>Inactive</option></select></div></div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary"><%= student._id ? 'Save changes' : 'Create student' %></button><a class="btn btn-outline-secondary" href="/students">Cancel</a></div></form></div><%- include('partials/footer') %>
