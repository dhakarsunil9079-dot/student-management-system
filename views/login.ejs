<%- include('partials/header') %><section class="auth-shell"><div class="auth-card"><span class="eyebrow">WELCOME BACK</span><h1>Sign in</h1><p class="muted">Continue to your student workspace.</p><% if (error || formError) { %><div class="alert alert-danger"><%= error || formError %></div><% } %><form method="POST" action="/login" class="needs-validation" novalidate><label class="form-label">Email address</label><input class="form-control" type="email" name="email" required placeholder="you@example.com"><label class="form-label mt-3">Password</label><input class="form-control" type="password" name="password" required placeholder="Your password"><button class="btn btn-primary w-100 mt-4">Sign in</button></form><p class="auth-switch">New here? <a href="/register">Create an account</a></p></div></section><%- include('partials/footer') %>
