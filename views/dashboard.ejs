<%- include('partials/header') %><div class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3"><div><span class="eyebrow">YOUR WORKSPACE</span><h1>Student records</h1><p class="muted mb-0">A clear view of the people behind your campus.</p></div><a href="/students/new" class="btn btn-primary">＋ Add student</a></div><% if (notice) { %><div class="alert alert-success"><%= notice %></div><% } %><% if (formError) { %><div class="alert alert-danger"><%= formError %></div><% } %><div class="stats-row"><div class="stat-card"><span>TOTAL RECORDS</span><strong><%= students.length %></strong><small>Matching students</small></div><div class="stat-card"><span>ACTIVE STUDENTS</span><strong><%= students.filter(s=>s.status==='Active').length %></strong><small>Currently active</small></div><div class="stat-card"><span>DATA MANAGEMENT</span><strong>Ready</strong><small>Search · Edit · Remove</small></div></div><div class="table-card"><div class="table-toolbar"><div><h2>All students</h2><p class="muted mb-0">Latest records appear first</p></div><form class="search-form" method="GET" action="/students"><input class="form-control" name="q" value="<%= q %>" placeholder="Search students..."><button class="btn btn-dark">Search</button></form></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>STUDENT</th><th>ENROLLMENT</th><th>COURSE</th><th>STATUS</th><th class="text-end">ACTIONS</th></tr></thead><tbody><% students.forEach(s=>{ %><tr><td><div class="student-cell"><span class="avatar"><%= s.name.charAt(0).toUpperCase() %></span><div><strong><%= s.name %></strong><small><%= s.email %></small></div></div></td><td><span class="enroll"><%= s.enrollmentNo %></span></td><td><%= s.course %></td><td><span class="status <%= s.status.toLowerCase() %>"><%= s.status %></span></td><td class="text-end"><a class="action-link" href="/students/<%= s._id %>/edit">Edit</a><form class="d-inline" method="POST" action="/students/<%= s._id %>?_method=DELETE" data-confirm="Delete this student record?"><button class="action-link danger-link">Delete</button></form></td></tr><% }) %><% if (!students.length) { %><tr><td colspan="5" class="empty-state">No students found. Add your first student or try another search.</td></tr><% } %></tbody></table></div><div class="table-bottom"><span>Showing <%= students.length %> record(s)</span><span>Maximum 100 records per view</span></div></div><%- include('partials/footer') %>
